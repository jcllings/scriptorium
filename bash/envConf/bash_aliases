#An alias for downloading a YouTube video and converting it to audio only MP3.

#Pull the sound out of a YouTube video and save it for later experimentation.
alias ytdMp3='yt-dlp -x --audio-format mp3 --audio-quality 5'
function grabMp3FmYt {

  ytdMp3 -I $1 -o "%(playlist_index)s-%(title)s.%(ext)s" --replace-in-metadata "title" " " "_" --replace-in-metadata "title" "\|" "-" --replace-in-metadata "title" "\(" "_" --replace-in-metadata "title" "\)" "" "$2"

}

